<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>LoveLevels</title>

  <!-- React -->
  <script src="https://unpkg.com/react/umd/react.production.min.js"></script>
  <script src="https://unpkg.com/react-dom/umd/react-dom.production.min.js"></script>

  <!-- Tailwind -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-pink-50 flex items-center justify-center min-h-screen p-6">
  <div id="root" class="w-full max-w-md"></div>

  <script>
    const { useState } = React;

    function LoveLevels() {
      const [step, setStep] = useState("start");
      const [score, setScore] = useState(0);
      const [level, setLevel] = useState(1);

      const questions = {
        1: {
          text: "¿Qué te atrae más en una persona?",
          options: [
            { text: "Su forma de hablar", points: 10 },
            { text: "Su mirada", points: 15 },
            { text: "Su energía", points: 20 }
          ]
        },
        2: {
          text: "¿Qué tipo de cita te gustaría?",
          options: [
            { text: "Café tranquilo", points: 10 },
            { text: "Paseo nocturno", points: 20 },
            { text: "Aventura espontánea", points: 30 }
          ]
        },
        3: {
          text: "¿Qué te hace sentir conexión?",
          options: [
            { text: "Conversación profunda", points: 25 },
            { text: "Risas naturales", points: 20 },
            { text: "Miradas que hablan", points: 30 }
          ]
        }
      };

      function answer(points) {
        const newScore = score + points;
        setScore(newScore);

        if (level < 3) {
          setLevel(level + 1);
        } else {
          setStep("result");
        }
      }

      if (step === "start") {
        return (
          <div className="bg-white p-6 rounded-xl shadow-xl text-center">
            <h1 className="text-3xl font-bold mb-4 text-pink-600">LoveLevels</h1>
            <p className="text-gray-600 mb-6">Descubre tu nivel de conexión.</p>
            <button
              onClick={() => setStep("play")}
              className="bg-pink-500 text-white px-6 py-3 rounded-lg font-semibold hover:bg-pink-600"
            >
              Comenzar
            </button>
          </div>
        );
      }

      if (step === "play") {
        const q = questions[level];
        return (
          <div className="bg-white p-6 rounded-xl shadow-xl">
            <h2 className="text-xl font-bold mb-4 text-pink-600">
              Nivel {level}
            </h2>
            <p className="text-gray-700 mb-6">{q.text}</p>

            {q.options.map((opt, i) => (
              <button
                key={i}
                onClick={() => answer(opt.points)}
                className="block w-full mb-3 bg-pink-500 text-white px-4 py-3 rounded-lg hover:bg-pink-600"
              >
                {opt.text}
              </button>
            ))}

            <div className="mt-6 text-sm text-gray-500">
              Puntos actuales: {score}
            </div>
          </div>
        );
      }

      if (step === "result") {
        let title = "";
        if (score < 40) title = "Conexión suave 💗";
        else if (score < 70) title = "Conexión intensa 🔥";
        else title = "Conexión total 💞";

        return (
          <div className="bg-white p-6 rounded-xl shadow-xl text-center">
            <h2 className="text-2xl font-bold mb-4 text-pink-600">{title}</h2>
            <p className="text-gray-700 mb-6">Tu LoveScore: {score}</p>

            <button
              onClick={() => { setScore(0); setLevel(1); setStep("start"); }}
              className="bg-pink-500 text-white px-6 py-3 rounded-lg font-semibold hover:bg-pink-600"
            >
              Jugar otra vez
            </button>
          </div>
        );
      }
    }

    ReactDOM.render(<LoveLevels />, document.getElementById("root"));
  </script>
</body>
</html>